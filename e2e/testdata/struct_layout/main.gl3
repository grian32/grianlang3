struct Tagged { int8 tag int value }
extern fnc calloc(uint count, uint size) -> Tagged*
extern fnc free(Tagged* ptr) -> none
fnc main() -> int32 {
 // Deliberately overallocate so a bad sizeof cannot make this check corrupt memory.
 def Tagged* values = calloc(2u64, 64u64)
 def int stride = ((values + 1) as int) - (values as int)
 def int32 reported = (sizeof Tagged) as int32
 def int32 failed = 0i32
 if (stride as int32) != reported { failed = 1i32 }
 values[0] = Tagged:{ 1i8, 123 }
 values[1] = Tagged:{ 2i8, 456 }
 def Tagged first = values[0]
 def Tagged second = values[1]
 if first.tag != 1i8 { failed = 2i32 }
 if first.value != 123 { failed = 3i32 }
 if second.tag != 2i8 { failed = 4i32 }
 if second.value != 456 { failed = 5i32 }
 free(values)
 return failed
}
