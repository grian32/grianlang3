fnc main() -> int32 {
 def uint32 high = 4000000000u32
 if high / 2u32 != 2000000000u32 { return 1i32 }
 if !(high > 1u32) { return 2i32 }
 if high < 1u32 { return 3i32 }
 if !(high >= 4000000000u32) { return 4i32 }
 if !(1u32 <= high) { return 5i32 }
 if -7i32 / 2i32 != -3i32 { return 6i32 }
 return 0i32
}
