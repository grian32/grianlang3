import "arrays"
fnc main() -> int32 {
 def int32* values = arr_new(sizeof int32) as int32*
 def int i = 0
 while i < 40 {
  def int32 value = i as int32
  arr_push(&values, &value)
  i = i + 1
 }
 i = 0
 def int32 failed = 0i32
 while i < 40 {
  if values[i] != (i as int32) { failed = 1i32 }
  i = i + 1
 }
 arr_free(&values)
 return failed
}
