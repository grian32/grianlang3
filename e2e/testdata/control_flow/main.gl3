import "io"
fnc fib(int32 n) -> int32 {
 if n <= 1i32 { return n }
 return fib(n - 1i32) + fib(n - 2i32)
}
fnc main() -> int32 {
 def int32 i = 0i32
 def int32 total = 0i32
 while i < 10i32 {
  i = i + 1i32
  if i == 3i32 { continue }
  if i == 6i32 { break }
  total = total + i
 }
 if total == 12i32 && fib(8i32) == 21i32 {
  println("control ok")
 } else { println("control wrong") }
 return 0i32
}
