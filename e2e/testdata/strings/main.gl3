import "strings"
extern fnc strcmp(char* a, char* b) -> int32
fnc main() -> int32 {
 def char* original = dynstr("hello")
 def char* unchanged = str_append(original, "")
 def char* joined = str_append(unchanged, " world")
 def int32 failed = 0i32
 if strcmp(original, "hello") != 0i32 { failed = 1i32 }
 if strcmp(unchanged, "hello") != 0i32 { failed = 2i32 }
 if strcmp(joined, "hello world") != 0i32 { failed = 3i32 }
 if str_len(original) != 5u64 { failed = 4i32 }
 if str_len(unchanged) != 5u64 { failed = 5i32 }
 if str_len(joined) != 11u64 { failed = 6i32 }
 str_free(joined)
 str_free(unchanged)
 str_free(original)
 return failed
}
