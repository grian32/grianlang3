struct Pair { int32 left int32 right }
fnc main() -> int32 {
 def Pair pair = Pair:{ 10i32, 20i32 }
 def Pair* p = &pair
 def int32* field = &p.right
 if *field != 20i32 { return 1i32 }
 *field = 42i32
 if pair.right != 42i32 { return 2i32 }
 if pair.left != 10i32 { return 3i32 }
 def int32* direct = &pair.right
 if direct != field { return 4i32 }
 return 0i32
}
