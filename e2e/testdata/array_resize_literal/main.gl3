import "arrays"
fnc main() -> int32 {
 // Cross both the initial capacity (16) and the next capacity (32).
 def int32* values = [int32; 0i32, 1i32, 2i32, 3i32, 4i32, 5i32, 6i32, 7i32, 8i32, 9i32, 10i32, 11i32, 12i32, 13i32, 14i32, 15i32, 16i32, 17i32, 18i32, 19i32, 20i32, 21i32, 22i32, 23i32, 24i32, 25i32, 26i32, 27i32, 28i32, 29i32, 30i32, 31i32, 32i32, 33i32, 34i32, 35i32, 36i32, 37i32, 38i32, 39i32]
 def int i = 0
 def int32 failed = 0i32
 while i < 40 {
  if values[i] != (i as int32) { failed = 1i32 }
  i = i + 1
 }
 arr_free(&values)
 return failed
}
