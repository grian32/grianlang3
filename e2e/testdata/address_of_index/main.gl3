extern fnc calloc(uint count, uint size) -> int32*
extern fnc free(int32* ptr) -> none
fnc main() -> int32 {
 def int32* values = calloc(3u64, sizeof int32)
 values[0] = 10i32
 values[1] = 20i32
 values[2] = 30i32
 def int index = 1
 def int32* element = &values[index]
 def int32 failed = 0i32
 if element != values + index { failed = 1i32 }
 if *element != 20i32 { failed = 2i32 }
 *element = 42i32
 if values[1] != 42i32 { failed = 3i32 }
 if values[0] != 10i32 { failed = 4i32 }
 if values[2] != 30i32 { failed = 5i32 }
 free(values)
 return failed
}
