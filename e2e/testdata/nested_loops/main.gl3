fnc main() -> int32 {
 def int32 outer = 0i32
 def int32 total = 0i32
 while outer < 3i32 {
  outer = outer + 1i32
  def int32 inner = 0i32
  while inner < 5i32 {
   inner = inner + 1i32
   if inner == 2i32 { continue }
   if inner == 4i32 { break }
   total = total + outer * 10i32 + inner
  }
  total = total + 100i32
 }
 if total != 432i32 { return 1i32 }
 if outer != 3i32 { return 2i32 }
 return 0i32
}
